# Configuración del servidor de internet. No contiene credenciales reales.
NODE_ENV=production
NUBE_ADMIN_USER=admin
NUBE_ADMIN_PASSWORD=
FAMBIT_ADMIN_TOTP_SECRET=
# Conserva local-test al trasladar los datos de la prueba Windows existente.
NUBE_ADMIN_OWNER=local-test
# En Render se usa RENDER_EXTERNAL_URL si este valor queda vacío.
NUBE_PUBLIC_ORIGIN=
NUBE_LISTEN_HOST=0.0.0.0
PORT=10000
NUBE_DATA_DIR=/var/data/fambit
FAMBIT_BACKUP_DIR=/var/data/backups
# Solo detrás del proxy de Render, sin acceso directo al puerto de Node.
FAMBIT_TRUST_PROXY_HOPS=1
# Se rellenan después de probar y alojar el EXE final. No publiques el ZIP fuente.
FAMBIT_DOWNLOAD_URL=
FAMBIT_DOWNLOAD_VERSION=
FAMBIT_DOWNLOAD_REVIT=
FAMBIT_CONTACT_EMAIL=
