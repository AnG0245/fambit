# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/artifacts/
/revit/**/bin/
/revit/**/obj/
/server-data/
/selfhost/dist/
/selfhost/service.mjs

/selfhost/catalog.mjs
!/selfhost/.env.example
*.env
*.pfx
*.key
*.sqlite*
/backups/
/private-config/
*.tsbuildinfo
admin-totp.json
.fambit-lock.json
# Firebase deploy output, emulator state and private operator configuration.
/firebase/dist/
/firebase/functions/node_modules/
/firebase/tooling/node_modules/
/firebase/functions/catalog.mjs
/firebase/.local-config.json
/.firebaserc
/.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
*.log
.secret.local
firebase.emulators.local.json
service-account*.json
*-firebase-adminsdk-*.json
!/firebase/functions/.env.example
