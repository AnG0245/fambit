<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)'==''">2024</RevitYear>
    <TargetFramework Condition="'$(RevitYear)'=='2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)'=='2025' Or '$(RevitYear)'=='2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)'=='2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><OutputType>Library</OutputType><PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NubeBIM</AssemblyName><RootNamespace>NubeBIM</RootNamespace><Version>0.5.0</Version>
    <DefineConstants Condition="'$(LocalTest)'=='true'">$(DefineConstants);NUBE_LOCAL_TEST</DefineConstants>
    <RevitApiDir Condition="'$(RevitApiDir)'==''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitApiDir>
    <OutputPath>bin\$(RevitYear)\$(Configuration)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Net.Http"/><Reference Include="System.Runtime.Serialization"/>
  </ItemGroup>
  <ItemGroup><Resource Include="Fonts\*.ttf"/><Resource Include="Fonts\OFL-Inter.txt"/></ItemGroup>
  <ItemGroup><Resource Include="Assets\fambit-mark.png"/></ItemGroup>
  <Target Name="CheckRevitApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPI.dll')" Text="Falta RevitAPI.dll de Revit $(RevitYear). Indica RevitApiDir desde una instalación autorizada de esa versión."/>
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPIUI.dll')" Text="Falta RevitAPIUI.dll oficial de Revit $(RevitYear)."/>
  </Target>
</Project>
