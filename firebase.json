{
  "functions": [{"source": "firebase/functions", "codebase": "fambit", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*.log", "*.local", ".env*", ".secret.local"], "predeploy": ["node scripts/build-firebase.mjs --functions-only"]}],
  "hosting": {
    "public": "firebase/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]},
      {"source": "/admin{,/**}", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
      {"source": "/downloads/**", "headers": [{"key": "Content-Disposition", "value": "attachment"}]}
    ],
    "rewrites": [
      {"source": "/api/**", "function": {"functionId": "fambitApi", "region": "us-central1"}},
      {"source": "/healthz", "function": {"functionId": "fambitApi", "region": "us-central1"}},
      {"source": "/admin{,/**}", "destination": "/admin.html"}
    ]
  },
  "firestore": {"rules": "firebase/firestore.rules", "indexes": "firebase/firestore.indexes.json"},
  "storage": {"rules": "firebase/storage.rules"},
  "emulators": {
    "auth": {"host": "127.0.0.1", "port": 9099},
    "firestore": {"host": "127.0.0.1", "port": 8080},
    "storage": {"host": "127.0.0.1", "port": 9199},
    "functions": {"host": "127.0.0.1", "port": 5001},
    "hosting": {"host": "127.0.0.1", "port": 5000},
    "ui": {"enabled": false}, "singleProjectMode": true
  }
}
